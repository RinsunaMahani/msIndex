# Copy to .env and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Signs the decision ledger and payment batches
MSINDEX_HMAC_KEY=
# Salts parcel pseudonyms; must be random, since parcel IDs follow a guessable pattern
MSINDEX_PARCEL_SALT=

# Optional: LLM underwriting briefing (Claude is used if both are set)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
